---
import "@/styles/global.css"
import "@/styles/openjev.css"
import "@/styles/docs.css"
import { getCollection } from "astro:content"
import DocsSidebar from "@/components/docs/DocsSidebar"
import DocsSearch from "@/components/docs/DocsSearch"
import DocsToc from "@/components/docs/DocsToc"
import Mark from "@/mark.svg"
import { render } from "astro:content"
import type { MarkdownHeading } from "astro"

interface Props {
  title: string
  description: string
  headings?: MarkdownHeading[]
  id?: string
}
const { title, description, headings = [], id } = Astro.props
const repo = "https://github.com/kylemclaren/jevql"
const all = (await getCollection("docs", (e) => !e.data.draft)).sort((a, b) => a.data.order - b.data.order)
const sections = ["Start", "Use", "Integrate", "Reference"] as const
const groups = sections
  .map((label) => ({
    label,
    items: all.filter((e) => e.data.section === label).map((e) => ({ label: e.data.title, href: `/docs/${e.id}/`, keywords: e.data.description })),
  }))
  .filter((g) => g.items.length > 0)
const searchPages = await Promise.all(
  all.map(async (e) => {
    const { headings: hs } = await render(e)
    const body = (e.body ?? "").replace(/```[\s\S]*?```/g, " ").replace(/<[^>]+>/g, " ").replace(/[#*_`>|-]+/g, " ").replace(/\s+/g, " ").toLowerCase()
    return { title: e.data.title, href: `/docs/${e.id}/`, section: e.data.section, description: e.data.description, headings: hs.filter((h) => h.depth <= 3).map((h) => h.text), body }
  }),
)
const idx = all.findIndex((e) => e.id === id)
const prev = idx > 0 ? all[idx - 1] : null
const next = idx >= 0 && idx < all.length - 1 ? all[idx + 1] : null
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3)
const pathname = Astro.url.pathname
const ogImage = new URL("/open-graph/index.png", Astro.site ?? Astro.url).href
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={`${title} · jevql docs`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} · jevql docs</title>
    <script is:inline>
      // Apply the saved docs theme before paint to avoid a flash.
      try {
        const t = localStorage.getItem("jevql-docs-theme") || (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light")
        document.documentElement.setAttribute("data-theme", t)
      } catch {}
    </script>
  </head>
  <body class="docs-body">
    <header class="mast docs-mast">
      <a class="brand" href="/"><Mark /> jevql <span class="docs-tag">docs</span></a>
      <div class="mast-right">
        <DocsSearch client:load pages={searchPages} />
        <button class="repo-link theme-toggle" id="theme-toggle" type="button" aria-label="Toggle dark mode">
          <span class="moon">☾ dark</span><span class="sun">☀ light</span>
        </button>
        <a class="repo-link" href={repo} target="_blank" rel="noopener">GitHub ↗</a>
      </div>
    </header>
    <div class="docs-shell">
      <DocsSidebar client:load groups={groups} pathname={pathname} />
      <main class="docs-main">
        <article class="doc">
          <nav class="doc-crumbs" aria-label="Breadcrumb"><a href="/docs/">docs</a><span>/</span><span>{all[idx]?.data.section ?? "page"}</span><span>/</span><b>{title}</b></nav>
          <h1>{title}</h1>
          <p class="doc-lede">{description}</p>
          <slot />
          <p class="doc-edit"><a href={`${repo}/blob/main/site/src/content/docs/${id}.mdx`} target="_blank" rel="noopener">Edit this page on GitHub ↗</a></p>
          <nav class="doc-pager" aria-label="Previous and next page">
            {prev ? <a href={`/docs/${prev.id}/`}><small>← previous</small><strong>{prev.data.title}</strong></a> : <span />}
            {next ? <a class="next" href={`/docs/${next.id}/`}><small>next →</small><strong>{next.data.title}</strong></a> : <span />}
          </nav>
        </article>
        {toc.length > 1 && (
          <aside class="doc-toc" aria-label="On this page">
            <DocsToc client:load headings={toc.map((h) => ({ depth: h.depth, slug: h.slug, text: h.text }))} />
          </aside>
        )}
      </main>
    </div>
    <script>
      import "@/scripts/copy-buttons"
      document.getElementById("theme-toggle")?.addEventListener("click", () => {
        const next = document.documentElement.getAttribute("data-theme") === "dark" ? "light" : "dark"
        document.documentElement.setAttribute("data-theme", next)
        try { localStorage.setItem("jevql-docs-theme", next) } catch {}
      })
      // heading anchor links
      for (const h of document.querySelectorAll<HTMLElement>(".doc h2[id], .doc h3[id]")) {
        const a = document.createElement("a")
        a.href = "#" + h.id
        a.className = "heading-anchor"
        a.setAttribute("aria-label", "Link to this section")
        a.textContent = "#"
        h.appendChild(a)
      }
    </script>
  </body>
</html>
