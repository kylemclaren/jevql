---
import { getCollection, render } from "astro:content"
import DocsLayout from "@/layouts/docs.astro"
import Callout from "@/components/docs/Callout.astro"
import Steps from "@/components/docs/Steps.astro"
import Cards from "@/components/docs/Cards.astro"
import Card from "@/components/docs/Card.astro"
import Kbd from "@/components/docs/Kbd.astro"
import Tabs from "@/components/docs/Tabs.astro"

export async function getStaticPaths() {
  const entries = await getCollection("docs", (e) => !e.data.draft)
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }))
}
const { entry } = Astro.props
const { Content, headings } = await render(entry)
---
<DocsLayout title={entry.data.title} description={entry.data.description} headings={headings} id={entry.id}>
  <Content components={{ Callout, Steps, Cards, Card, Kbd, Tabs }} />
</DocsLayout>
