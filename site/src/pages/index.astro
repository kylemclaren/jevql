---
import Layout from "@/layouts/main.astro"
import Mark from "@/mark.svg"
import Tabs from "@/components/docs/Tabs.astro"
import { Code } from "astro:components"
import { siClaude, siCursor, siOpencode } from "simple-icons"
import openaiPath from "../openai-path.txt?raw"
const agentPrompt = "Set me up with jevql: https://jevql.fly.dev/agent-ready.md"
const coins = [
  { name: "Claude", d: siClaude.path },
  { name: "OpenAI", d: openaiPath.trim() },
  { name: "Cursor", d: siCursor.path },
]

const goExample = `client, _ := jevql.New(ctx, jevql.Options{DatabaseURL: os.Getenv("DATABASE_URL")})
defer client.Close(ctx)

rows, err := client.QueryMaps(ctx, \`
  SELECT name, jev_prob(people, 'could work from home') AS p
  FROM people WHERE country = 'PT'
  ORDER BY p DESC LIMIT 5\`)`
const tsExample = `import { Jevql } from "jevql"

const db = new Jevql() // bundled engine, reads DATABASE_URL and TYPESAFE_API_KEY

const tickets = await db.queryObjects(\`
  SELECT id, subject FROM tickets
  WHERE jev(tickets, 'is about billing') AND status = 'open'\`)`
const mcpClaude = `# local, on stdio
claude mcp add jevql -- jevql mcp

# a shared node over HTTP
claude mcp add --transport http jevql https://your-node.fly.dev/mcp \\
  --header "Authorization: Bearer $JEVQL_TOKEN"`
const mcpOpenAI = `# Codex CLI
codex mcp add jevql -- jevql mcp

# ChatGPT: Settings → Connectors → add an MCP server
#   URL    https://your-node.fly.dev/mcp
#   Auth   Bearer <your JEVQL_TOKEN>`
const mcpCursor = `// .cursor/mcp.json (project) or ~/.cursor/mcp.json (global)
{
  "mcpServers": {
    "jevql": { "command": "jevql", "args": ["mcp"] }
  }
}`
const mcpOpencode = `// opencode.json
{
  "mcp": {
    "jevql": { "type": "local", "command": ["jevql", "mcp"], "enabled": true }
  }
}`
const pyExample = `from jevql import Jevql

with Jevql() as db:  # bundled engine; Jevql(url=...) for a shared one
    for row in db.query_dicts("""
        SELECT title FROM movies
        WHERE jev(movies, 'a safe pick for a first date')"""):
        print(row["title"])`

const repo = "https://github.com/kylemclaren/jevql"
const install = "brew install kylemclaren/tap/jevql"
---

<Layout>
  <main class="page">
    <header class="mast">
      <a class="brand" href="./"><Mark /> jevql</a>
      <div class="mast-right">
        <span class="tagline">Semantic SQL for vanilla Postgres</span>
        <a class="repo-link" href="/playground/">playground</a>
        <a class="repo-link" href="/docs/">docs</a>
        <a class="repo-link" href={repo} target="_blank" rel="noopener" aria-label="GitHub repository (opens in a new tab)">
          <svg class="gh" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
          GitHub
        </a>
      </div>
    </header>

    <section class="hero">
      <h1>Ask your database <mark>a real question.</mark></h1>
      <p class="lede">
        Put
        <code class="hero-snippet"><span class="kw">WHERE</span> <span class="fn">jev</span><span class="pn">(</span>people<span class="pn">,</span> <span class="str">'could work from home'</span><span class="pn">)</span></code>
        in a query: Postgres runs the SQL, Jev judges the rows, you get the table. From the CLI, from Go, TypeScript or Python, or from an agent over MCP. Works on any Postgres you can already connect to, no extension required.
      </p>
      <div class="install-cta">
        <button class="copy prompt-pill" type="button" data-copy={agentPrompt} aria-label="Copy a prompt to give to your AI agent" title="Copies: Set me up with jevql: https://jevql.fly.dev/agent-ready.md">
          <span class="coins" aria-hidden="true">
            {coins.map((c, i) => (
              <span class="coin" style={`z-index:${coins.length - i}; --i:${i}`}><svg viewBox="0 0 24 24" width="16" height="16"><path fill="currentColor" d={c.d} /></svg></span>
            ))}
          </span>
          <span class="pill-text"><b>Hand it to your agent</b><small>copies a one-line setup prompt</small></span>
        </button>
      </div>
      <div class="truth-strip">
        <span>works on any postgres</span><span>no extension</span><span>no proxy</span><span>answers cached</span><span>$0.042 / M tokens</span>
      </div>
    </section>

    <dialog id="dl" aria-labelledby="dl-title">
      <div class="dl-head">
        <div><p class="eyebrow">download</p><h2 id="dl-title">Get jevql</h2></div>
        <button id="dl-close" class="secondary" type="button" aria-label="Close">✕</button>
      </div>
      <p class="dl-version">latest release: <strong id="dl-tag">…</strong></p>
      <div class="dl-curl">
        <small>one line, detects your platform</small>
        <div class="dl-curl-row">
          <code id="curl-line">curl -fsSL …/install.sh | sh</code>
          <button class="secondary copy small" type="button" data-copy-from="curl-line" aria-label="Copy install command"><span class="material-symbols-rounded" aria-hidden="true">content_copy</span></button>
        </div>
      </div>
      <p class="dl-or">or pick a tarball</p>
      <div class="dl-grid" id="dl-grid">
        {[
          ["darwin", "arm64", "macOS", "Apple Silicon"],
          ["darwin", "amd64", "macOS", "Intel"],
          ["linux", "amd64", "Linux", "x86_64"],
          ["linux", "arm64", "Linux", "arm64"],
        ].map(([os, arch, label, name]) => (
          <div class="dl-tile" data-os={os} data-arch={arch}>
            <small>{label}</small>
            <strong>{name}</strong>
            <div class="dl-actions">
              <a class="dl-get" href={`${repo}/releases/latest`} download><span class="material-symbols-rounded" aria-hidden="true">download</span> download</a>
              <button class="dl-copy copy small" type="button" data-copy="" aria-label={`Copy ${label} ${name} link`}><span class="material-symbols-rounded" aria-hidden="true">link</span></button>
            </div>
          </div>
        ))}
      </div>
      <p class="fine">Tarballs contain the <code>jevql</code> binary; unpack it onto your PATH. Checksums are on the <a href={`${repo}/releases/latest`}>release page</a>.</p>
    </dialog>

    <section class="examples" aria-label="Examples">
      <div class="examples-head">
        <p class="eyebrow">examples · <span id="ex-name">people</span></p>
        <div class="dots" id="ex-dots" role="tablist" aria-label="Pick an example"></div>
      </div>
      <div class="race">
        <article class="lane direct">
          <div class="lane-head"><div><p class="eyebrow">you type</p><h2>Plain SQL, one new function</h2></div><span class="badge">query</span></div>
          <pre class="output" id="ex-query"></pre>
        </article>
        <article class="lane generated">
          <div class="lane-head"><div><p class="eyebrow">you get</p><h2>Rows, plus what it cost</h2></div><span class="badge pink">result</span></div>
          <pre class="output" id="ex-result"></pre>
        </article>
      </div>
      <div class="meter ex-meter" aria-hidden="true"><i id="ex-progress"></i></div>
    </section>

    <section class="machine" aria-labelledby="install-title">
      <div class="section-head">
        <div><p class="eyebrow">install</p><h2 id="install-title">Install it, then type <code>jevql</code></h2></div>
      </div>
      <div class="install-cta install-actions">
        <button id="download" class="secondary" type="button">
          <span class="material-symbols-rounded" aria-hidden="true">download</span> <span id="dl-label">download jevql</span>
        </button>
        <button class="secondary copy" type="button" data-copy={install}>
          <span class="material-symbols-rounded" aria-hidden="true">content_copy</span> {install}
        </button>
      </div>
      <p class="install-alt">
        <span>or</span>
        <button class="copy chip" type="button" data-copy="curl -fsSL https://jevql.fly.dev/install.sh | sh"><span class="material-symbols-rounded" aria-hidden="true">content_copy</span> curl -fsSL jevql.fly.dev/install.sh | sh</button>
        <button class="copy chip" type="button" data-copy="CGO_ENABLED=1 go install github.com/kylemclaren/jevql/cmd/jevql@latest"><span class="material-symbols-rounded" aria-hidden="true">content_copy</span> go install</button>
        <a class="chip" href={`${repo}/releases`} target="_blank" rel="noopener">release tarballs ↗</a>
      </p>
      <p class="fine">First launch asks for a database URL and a TypeSafe key and saves them to <code>~/.config/jevql/env</code>. Or set <code>DATABASE_URL</code> and <code>TYPESAFE_API_KEY</code> like any psql user.</p>
    </section>

    <section class="method-map" aria-label="How a query runs">
      <div><small>1 / collect</small><strong>Postgres runs your SQL with the jev terms stripped. Indexed filters stay on the server.</strong></div>
      <div class="arrow" aria-hidden="true">→</div>
      <div class="method-model"><small>2 / judge</small><strong>Surviving rows go to TypeSafe in batches. Identical rows are judged once and cached.</strong></div>
      <div class="arrow" aria-hidden="true">→</div>
      <div><small>3 / project</small><strong>Filter, sort, group and limit happen in the CLI. You get a psql table.</strong></div>
    </section>

    <section class="machine" aria-labelledby="functions-title">
      <div class="section-head">
        <div><p class="eyebrow">functions</p><h2 id="functions-title">One family of functions</h2></div>
        <a class="repo-link" href={`${repo}#sql-surface`} target="_blank" rel="noopener">full surface ↗</a>
      </div>
      <div class="phases" aria-label="Functions">
        <div class="phase"><small>boolean</small><strong>jev()</strong><span><code>jev(p, 'condition' [, 0.7])</code><br />A calibrated probability against a threshold. Works in WHERE, also as <code>NOT jev()</code>.</span></div>
        <div class="phase"><small>numbers</small><strong>jev_prob() · jev_score()</strong><span><code>jev_prob(p, 'condition')</code> → 0..1<br /><code>jev_score(p, 'q', ARRAY['lo','mid','hi'])</code> → weighted level</span></div>
        <div class="phase"><small>labels</small><strong>jev_choice()</strong><span><code>jev_choice(t, 'which team?', ARRAY['billing','technical'])</code><br />Works with GROUP BY and count(*).</span></div>
      </div>
      <p class="fine">Send fewer columns with <code>jev((name, bio), '…')</code>. Anything without <code>jev_*</code> passes straight through, so it doubles as a plain psql.</p>
    </section>

    <section class="machine" aria-labelledby="sdk-title">
      <div class="section-head">
        <div><p class="eyebrow">sdks</p><h2 id="sdk-title">The same engine, from your code</h2></div>
        <a class="repo-link" href="/docs/sdk-go/">sdk docs</a>
      </div>
      <Tabs labels={["Go", "TypeScript", "Python"]} storageKey="landing-sdk">
        <div><Code code={goExample} lang="go" theme="github-light" /><p class="fine">In process: <code>go get github.com/kylemclaren/jevql/sdk/go</code>. Same parser, cache and client as the CLI.</p></div>
        <div><Code code={tsExample} lang="ts" theme="github-light" /><p class="fine"><code>npm i jevql</code>. The engine ships inside the package; nothing else to install. Point it at a shared <code>jevql serve</code> with <code>{"{"} url {"}"}</code>.</p></div>
        <div><Code code={pyExample} lang="python" theme="github-light" /><p class="fine"><code>pip install jevql</code>. Standard library only, engine included. Same embedded-or-remote choice.</p></div>
      </Tabs>
    </section>

    <section class="machine mcp" aria-labelledby="mcp-title">
      <div class="section-head">
        <div><p class="eyebrow">mcp</p><h2 id="mcp-title">Agents get the same superpower</h2></div>
        <a class="repo-link" href="/docs/mcp/">mcp docs</a>
      </div>
      <p class="mcp-lede">
        <code>jevql mcp</code> is a Model Context Protocol server. Claude, Cursor or any MCP client can ask your database
        real questions: the <code>query</code> tool runs SQL with <code>jev()</code> in it, <code>explain</code> prices a query before it runs,
        <code>judge</code> scores rows the agent already holds, and <code>list_tables</code> / <code>describe_table</code> let it find its way around.
        Read-only by default.
      </p>
      <Tabs labels={["Claude Code", "OpenAI", "Cursor", "OpenCode"]} icons={[siClaude.path, openaiPath.trim(), siCursor.path, siOpencode.path]} storageKey="landing-mcp">
        <div><Code code={mcpClaude} lang="bash" theme="github-light" /><p class="fine">Reads <code>DATABASE_URL</code> and <code>TYPESAFE_API_KEY</code> from your shell, like the CLI.</p></div>
        <div><Code code={mcpOpenAI} lang="bash" theme="github-light" /><p class="fine">ChatGPT only speaks to remote servers, so point it at a <a href="/docs/deploy/">node</a>. Codex runs the local one.</p></div>
        <div><Code code={mcpCursor} lang="json" theme="github-light" /><p class="fine">Enable it under Settings → MCP. Ask Cursor to "list the tables and find open tickets that sound angry".</p></div>
        <div><Code code={mcpOpencode} lang="json" theme="github-light" /><p class="fine">Restart OpenCode; the five tools show up under <code>jevql_*</code>.</p></div>
      </Tabs>
      <div class="phases mcp-tools" aria-label="MCP tools">
        <div class="phase"><small>query</small><strong>Semantic SQL</strong><span>"Which open tickets sound like churn risks?" becomes <code>WHERE jev(t, '…')</code> and comes back as rows.</span></div>
        <div class="phase"><small>explain</small><strong>Price first</strong><span>Rows after filters, batches, tokens and dollars, with no TypeSafe call. Agents check before they spend.</span></div>
        <div class="phase"><small>judge</small><strong>Rows in hand</strong><span>Score, classify or filter any JSON rows the agent already has, same cache, no database round trip.</span></div>
      </div>
    </section>


    <details>
      <summary>Read before pointing it at real data</summary>
      <div class="details-grid">
        <p><b>Row contents go to TypeSafe.</b> Every column of the judged alias is sent over HTTPS. Narrow it with <code>jev((name, bio), …)</code> or <code>--columns</code>.</p>
        <p><b>It scans everything your SQL filters let through.</b> Put cheap predicates first. <code>--explain</code> shows the collect SQL, row count and cost with no API call; <code>--max-rows</code> aborts before HTTP.</p>
        <p><b>Not an extension.</b> <code>jev()</code> exists only inside this CLI and its SDKs. Apps sending it straight through JDBC or psycopg will get "function does not exist".</p>
        <p><b>The cache is a local sqlite file.</b> Keyed by model, question and canonical row JSON. Mode 0600, no expiry. <code>\cache clear</code> or <code>--no-cache</code>.</p>
      </div>
    </details>

    <footer>
      <span>jevQL · MIT</span>
      <span><a href={repo} target="_blank" rel="noopener">GitHub</a> · <a href="https://typesafe.ai">TypeSafe</a> · styled after <a href="https://github.com/TheoLeeCJ/openjev">openjev</a></span>
    </footer>
  </main>

  <script>
    import "@/scripts/copy-buttons"
    const repo = "https://github.com/kylemclaren/jevql"
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches

    // ---- copy buttons -------------------------------------------------
    function flash(btn: HTMLElement, ok = true) {
      if (btn.classList.contains("prompt-pill")) {
        const t = btn.querySelector(".pill-text")!
        const original = t.innerHTML
        t.innerHTML = ok ? "<b>Copied</b><small>paste it into Claude, ChatGPT or Cursor</small>" : "<b>Copy failed</b><small>select the text at /agent-ready.md instead</small>"
        btn.classList.add("done")
        setTimeout(() => { t.innerHTML = original; btn.classList.remove("done") }, 1600)
        return
      }
      const original = btn.innerHTML
      btn.innerHTML = `<span class="material-symbols-rounded" aria-hidden="true">${ok ? "check" : "close"}</span>${btn.classList.contains("small") ? "" : " copied"}`
      setTimeout(() => (btn.innerHTML = original), 1200)
    }
    document.addEventListener("click", async (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>(".copy")
      if (!btn) return
      const from = btn.dataset.copyFrom
      const text = from ? document.getElementById(from)?.textContent || "" : btn.dataset.copy || ""
      try {
        await navigator.clipboard.writeText(text)
        flash(btn)
      } catch {
        flash(btn, false)
      }
    })

    // ---- install command reflects where the site is hosted -------------
    const curl = `curl -fsSL ${location.origin}/install.sh | sh`
    for (const id of ["curl-line", "curl-line-2"]) {
      const el = document.getElementById(id)
      if (el) el.textContent = curl
    }

    // ---- download dialog -----------------------------------------------
    const dl = document.getElementById("dl") as HTMLDialogElement | null
    const tagEl = document.getElementById("dl-tag")
    let loaded = false
    async function loadRelease() {
      if (loaded) return
      loaded = true
      try {
        const r = await fetch("https://api.github.com/repos/kylemclaren/jevql/releases/latest", { headers: { Accept: "application/vnd.github+json" } })
        if (!r.ok) throw new Error(String(r.status))
        const rel = await r.json()
        const tag: string = rel.tag_name
        const ver = tag.replace(/^v/, "")
        if (tagEl) tagEl.textContent = tag
        for (const tile of document.querySelectorAll<HTMLElement>(".dl-tile")) {
          const name = `jevql_${ver}_${tile.dataset.os}_${tile.dataset.arch}.tar.gz`
          const asset = (rel.assets || []).find((x: { name: string }) => x.name === name)
          const url = asset ? asset.browser_download_url : `${repo}/releases/download/${tag}/${name}`
          const a = tile.querySelector<HTMLAnchorElement>(".dl-get")
          if (a) { a.href = url; a.setAttribute("download", name) }
          const c = tile.querySelector<HTMLElement>(".dl-copy")
          if (c) c.dataset.copy = url
        }
      } catch {
        if (tagEl) tagEl.textContent = "see releases page"
      }
    }
    const ua = navigator.userAgent
    const guessOS = /Mac/i.test(ua) ? "darwin" : /Linux|Android/i.test(ua) ? "linux" : ""
    // Browsers on Apple Silicon still say "Intel", so never guess the Mac architecture.
    const guessArch = guessOS === "linux" ? (/arm64|aarch64/i.test(ua) ? "arm64" : "amd64") : ""
    if (guessArch) document.querySelector(`.dl-tile[data-os="${guessOS}"][data-arch="${guessArch}"]`)?.classList.add("likely")
    const platformName = guessOS === "darwin" ? "macOS" : guessOS === "linux" ? `Linux · ${guessArch}` : ""
    const label = document.getElementById("dl-label")
    if (label && platformName) label.textContent = `download for ${platformName}`
    fetch("https://api.github.com/repos/kylemclaren/jevql/releases/latest", { headers: { Accept: "application/vnd.github+json" } })
      .then((r) => (r.ok ? r.json() : null))
      .then((rel) => { if (rel && label) label.textContent = `${label.textContent} · ${rel.tag_name}` })
      .catch(() => {})
    document.getElementById("download")?.addEventListener("click", () => { loadRelease(); dl?.showModal() })
    document.getElementById("dl-close")?.addEventListener("click", () => dl?.close())
    dl?.addEventListener("click", (e) => { if (e.target === dl) dl.close() })

    // ---- rotating examples ---------------------------------------------
    type Example = { name: string; query: string; result: string }
    const examples: Example[] = [
      {
        name: "people",
        query: `SELECT name, city,
       jev_prob(people, 'could work from home') AS p
FROM people
WHERE jev(people, 'could work from home')
  AND country = 'PT'
ORDER BY p DESC
LIMIT 20;`,
        result: `     name      |  city  |  p
---------------+--------+------
 Miguel Costa  | Lisbon | 0.94
 Ada Fernandes | Lisbon | 0.93
 Pedro Martins | Lisbon | 0.91
(3 rows)

jev: 6 judged, 1 req, 0 cache hits, 1.2k tokens, $0.0001, 1.35s`,
      },
      {
        name: "support tickets",
        query: `SELECT jev_choice(tickets, 'which team should handle this?',
                  ARRAY['billing','technical','sales']) AS team,
       count(*)
FROM tickets
WHERE status = 'open'
GROUP BY 1
ORDER BY 2 DESC;`,
        result: `   team    | count
-----------+-------
 technical |     3
 sales     |     3
 billing   |     1
(3 rows)

jev: 7 judged, 1 req, 0 cache hits, 1.2k tokens, $0.0001, 0.75s`,
      },
      {
        name: "movies",
        query: `SELECT title, year
FROM movies
WHERE jev(movies, 'a safe pick for a first date')
  AND year >= 2010
ORDER BY year DESC
LIMIT 4;`,
        result: `          title          | year
-------------------------+------
 Past Lives              | 2023
 The Big Sick            | 2017
 About Time              | 2013
 Silver Linings Playbook | 2012
(4 rows)

jev: 412 judged, 11 req, 0 cache hits, 61.3k tokens, $0.0026, 4.1s`,
      },
      {
        name: "inbox",
        query: `SELECT sender, subject
FROM emails
WHERE NOT jev(emails, 'a newsletter or promotion')
  AND received > now() - interval '1 day'
ORDER BY received DESC;`,
        result: `     sender      |            subject
-----------------+--------------------------------
 Joana Silva     | Re: Q4 hiring plan
 Ravi Patel      | Invoice #4821 corrected
 Ada Fernandes   | Can we ship Friday?
(3 rows)

jev: 58 judged, 2 req, 21 cache hits, 5.9k tokens, $0.0002, 1.9s`,
      },
      {
        name: "reviews",
        query: `SELECT product,
       jev_score(reviews, 'how angry is the customer?',
                 ARRAY['calm','annoyed','furious']) AS anger
FROM reviews
WHERE stars <= 2
ORDER BY anger DESC
LIMIT 3;`,
        result: `    product     | anger
----------------+-------
 Cold brew kit  |  1.96
 Desk lamp v2   |  1.41
 Wool socks     |  0.87
(3 rows)

jev: 133 judged, 4 req, 0 cache hits, 21.0k tokens, $0.0009, 2.6s`,
      },
      {
        name: "recipes",
        query: `SELECT name, jev_prob(recipes, 'kid friendly') AS p
FROM recipes
WHERE jev((name, ingredients), 'vegetarian')
ORDER BY p DESC
LIMIT 3;`,
        result: `        name         |  p
---------------------+------
 Mac and cheese      | 0.97
 Margherita pizza    | 0.95
 Lentil shepherd pie | 0.62
(3 rows)

jev: 240 judged, 6 req, 120 cache hits, 17.8k tokens, $0.0007, 2.2s`,
      },
    ]

    const q = document.getElementById("ex-query")!
    const res = document.getElementById("ex-result")!
    const nameEl = document.getElementById("ex-name")!
    const dots = document.getElementById("ex-dots")!
    const bar = document.getElementById("ex-progress") as HTMLElement
    const HOLD = 7000
    let idx = 0, run = 0, paused = false, timer: number | undefined

    examples.forEach((ex, i) => {
      const b = document.createElement("button")
      b.type = "button"
      b.role = "tab"
      b.setAttribute("aria-label", ex.name)
      b.addEventListener("click", () => show(i, true))
      dots.appendChild(b)
    })

    function setBar(active: boolean) {
      bar.style.transition = "none"
      bar.style.width = "0%"
      if (!active) return
      requestAnimationFrame(() => requestAnimationFrame(() => {
        bar.style.transition = `width ${HOLD}ms linear`
        bar.style.width = "100%"
      }))
    }

    async function show(i: number, manual = false) {
      const my = ++run
      if (timer) clearTimeout(timer)
      idx = i
      const ex = examples[i]
      nameEl.textContent = ex.name
      dots.querySelectorAll("button").forEach((b, j) => b.setAttribute("aria-selected", String(j === i)))
      res.classList.remove("show")
      res.textContent = ex.result
      setBar(false)
      if (reduced || manual) {
        q.textContent = ex.query
      } else {
        q.textContent = ""
        q.classList.add("typing")
        for (let n = 1; n <= ex.query.length; n++) {
          if (my !== run) return
          q.textContent = ex.query.slice(0, n)
          const ch = ex.query[n - 1]
          await new Promise((r) => setTimeout(r, ch === "\n" ? 90 : 12))
        }
        q.classList.remove("typing")
        await new Promise((r) => setTimeout(r, 250))
        if (my !== run) return
      }
      res.classList.add("show")
      setBar(true)
      timer = window.setTimeout(() => { if (!paused) show((idx + 1) % examples.length) }, HOLD)
    }
    const wrap = document.querySelector(".examples")!
    wrap.addEventListener("mouseenter", () => { paused = true })
    wrap.addEventListener("mouseleave", () => { paused = false; if (!timer) show((idx + 1) % examples.length) })
    show(0, true)
  </script>
</Layout>

